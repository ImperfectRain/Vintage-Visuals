<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Per-machine paths and overrides live in Properties/localSettings.props,
    which is gitignored. It is generated on first build (see EnsureLocalSettings
    below) and defaults GameDirectory to the VINTAGE_STORY environment variable.
    Imported before the defaults so anything it sets wins.
  -->
  <Import Project="Properties\localSettings.props" Condition="Exists('Properties\localSettings.props')" />

  <PropertyGroup>
    <!--
      TargetFramework MUST be greater than or equal to the framework the
      installed game's VintagestoryAPI.dll was built against. This is a
      compile-time rule and it does not work the way runtime loading does:
      a net8.0 assembly happily *loads* on a .NET 10 runtime, but you cannot
      *compile* against a reference assembly that targets a higher framework.

      Getting this wrong produces a wall of MSB3277 warnings followed by:
          error CS1705: Assembly 'VintagestoryAPI' ... uses 'System.Runtime,
          Version=10.0.0.0' which has a higher version than referenced
          assembly 'System.Runtime, Version=8.0.0.0'
      If you see that, this value is below your game's framework - raise it.

      net10.0 matches Vintage Story 1.22+ and is confirmed building clean
      against a 1.22.7 install. On 1.21, which shipped on .NET 8, set net8.0 in
      Properties/localSettings.props rather than editing this line, so the
      override stays out of version control.

      Note that -p:TargetFramework=... on the command line does NOT work here:
      it changes the build without re-running restore, so the assets file has
      no target for the new framework and you get NETSDK1005 instead.
    -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VintageVisuals</AssemblyName>
    <RootNamespace>VintageVisuals</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.0.1</Version>
    <!-- The game loads mods from a flat folder; satellite/deps files just add noise. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!--
      Required, not optional. Library projects do NOT copy their NuGet
      dependencies to the output folder by default, so without this YamlDotNet
      never ships beside the mod dll and the game throws FileNotFoundException
      the first time a shader patch file is parsed - at load, with the mod
      already half-initialised. The game resolves a mod's dependencies from its
      own folder, so the assembly has to physically be there.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(VINTAGE_STORY)</GameDirectory>
    <OutputPath>bin\$(Configuration)\Mods\vintagevisuals</OutputPath>
    <ReleasesDir>$(MSBuildProjectDirectory)\Releases</ReleasesDir>
  </PropertyGroup>

  <!--
    Game assemblies. Private=false keeps them out of the mod folder - the game
    already has them loaded, and shipping copies causes type-identity errors.

    VintagestoryAPI  - the public modding API (ModSystem, ICoreClientAPI,
                       IShaderProgram, IShader, ...). Everything this mod
                       compiles against lives here.
    0Harmony         - runtime patching, ships in the game's Lib folder.

    Config serialization goes through ICoreAPI.LoadModConfig/StoreModConfig, so
    Newtonsoft.Json needs no reference here; OpenTK is likewise unreferenced
    because nothing in this mod touches GL directly.

    Deliberately NOT referenced: VintagestoryLib. The one internal type we need
    (ShaderRegistry, to intercept vanilla GLSL) is resolved by name at runtime
    in src/Common/ShaderSourceInterceptor.cs, so a rename there degrades to a
    logged error instead of a build break, and nothing else in the mod acquires
    a dependency on unstable internals.
  -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI" HintPath="$(GameDirectory)/VintagestoryAPI.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDirectory)/Lib/0Harmony.dll" Private="false" />
  </ItemGroup>

  <!--
    YamlDotNet is NOT referenced from the game folder: the game does not ship
    it. It is pulled from NuGet and copied next to the mod dll so the game's
    assembly resolver finds it.
  -->
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="15.1.2" />
  </ItemGroup>

  <!-- Assets and modinfo are content, copied verbatim into the mod folder. -->
  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="modicon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('modicon.png')" />
    <None Include="assets\**\*">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- /tools is the offline PBR prototype (Python). Never compiled into the mod. -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <Target Name="EnsureLocalSettings" BeforeTargets="PrepareForBuild" Condition="!Exists('Properties\localSettings.props')">
    <MakeDir Directories="Properties" />
    <WriteLinesToFile File="Properties\localSettings.props" Overwrite="true" Lines="&lt;Project&gt;%0A  &lt;PropertyGroup&gt;%0A    &lt;GameDirectory&gt;%24(VINTAGE_STORY)&lt;/GameDirectory&gt;%0A    &lt;!-- Uncomment for Vintage Story 1.21, which shipped on .NET 8: --&gt;%0A    &lt;!-- &lt;TargetFramework&gt;net8.0&lt;/TargetFramework&gt; --&gt;%0A  &lt;/PropertyGroup&gt;%0A&lt;/Project&gt;" />
    <Message Importance="high" Text="Generated Properties/localSettings.props - set GameDirectory there if VINTAGE_STORY is not set." />
  </Target>

  <Target Name="CheckGameDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDirectory)' == ''"
           Text="GameDirectory is empty. Set the VINTAGE_STORY environment variable to your Vintage Story install folder, or set &lt;GameDirectory&gt; in Properties/localSettings.props." />
    <Error Condition="!Exists('$(GameDirectory)/VintagestoryAPI.dll')"
           Text="VintagestoryAPI.dll not found under '$(GameDirectory)'. Point GameDirectory at the folder containing VintagestoryAPI.dll." />
  </Target>

  <!--
    Removed assets must actually disappear from the output.

    CopyToOutputDirectory copies files and never deletes them, so a YAML patch
    file deleted from the repo lives on in bin/ - and from there into whatever
    Mods folder was copied out of it. Two shader patch groups that had been
    DELETED for causing visible bugs, weathersky and cloudshape, were still
    being loaded and applied in a player's game weeks later. The log said
    "loaded 55 shader patch(es) from 8 file(s)" while the repo had six, and the
    sky-fogging group that was removed for flattening clouds into a haze was
    doing exactly that again.

    Wiping the asset folder before the copy makes the output a mirror of the
    repo rather than an accumulation of every build ever run.
  -->
  <Target Name="CleanStaleAssets" BeforeTargets="PrepareForBuild" Condition="Exists('$(OutputPath)assets')">
    <RemoveDir Directories="$(OutputPath)assets" />
  </Target>

  <Target Name="ZipRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(ReleasesDir)" />
    <ZipDirectory SourceDirectory="$(OutputPath)" DestinationFile="$(ReleasesDir)\vintagevisuals_$(Version).zip" Overwrite="true" />
  </Target>

</Project>
